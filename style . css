:root {
    --bg-main: #f8fafc;
    --card-bg: #ffffff;
    --text-primary: #0f172a;
    --text-secondary: #475569;
    --text-muted: #94a3b8;
    --accent: #2563eb;
    --accent-hover: #1d4ed8;
    --accent-light: #eff6ff;
    --border: #e2e8f0;
    --border-focus: #93c5fd;
    --danger: #ef4444;
    --radius-lg: 16px;
    --radius-md: 8px;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 20px -2px rgba(0,0,0,0.05);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* NAVBAR */
.navbar {
    background: var(--card-bg);
    border-bottom: 1px solid var(--border);
    padding: 16px 24px;
}

.nav-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand-logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.5px;
}

.brand-logo span {
    color: var(--accent);
}

.badge {
    background: var(--accent-light);
    color: var(--accent);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
}

/* MAIN LAYOUT */
.main-layout {
    max-width: 900px;
    margin: 40px auto;
    padding: 0 20px;
    flex: 1;
}

.calculator-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-md);
    margin-bottom: 40px;
}

.card-header {
    margin-bottom: 28px;
}

.card-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
}

.card-header p {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

/* TABLE & INPUTS */
.table-header {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1fr 1.2fr 40px;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--bg-main);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.course-list {
    margin: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.course-row {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1fr 1.2fr 40px;
    gap: 12px;
    align-items: center;
}

input, select {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-main);
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    transition: all 0.2s ease;
}

input:focus, select:focus {
    border-color: var(--accent);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.btn-remove {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    text-align: center;
    line-height: 1;
    transition: color 0.2s;
}

.btn-remove:hover {
    color: var(--danger);
}

/* BUTTONS */
.action-buttons {
    display: flex;
    gap: 12px;
    margin-top: 24px;
}

button.btn-secondary {
    background: var(--accent-light);
    color: var(--accent);
    border: none;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
}

button.btn-secondary:hover {
    background: #dbeafe;
}

button.btn-outline {
    background: none;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
}

button.btn-outline:hover {
    background: var(--bg-main);
}

/* RESULTS BOX */
.results-container {
    margin-top: 32px;
    background: var(--bg-main);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    border: 1px solid var(--border);
}

.result-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.metric-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
}

.metric-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
}

.result-metric.highlight .metric-value {
    color: var(--accent);
}

.result-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
}

/* EDUCATIONAL CONTENT */
.educational-content {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-sm);
}

.educational-content h2 {
    font-size: 1.4rem;
    margin-bottom: 12px;
}

.educational-content h3 {
    font-size: 1.1rem;
    margin: 24px 0 8px 0;
}

.educational-content p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 12px;
}

.table-responsive {
    overflow-x: auto;
    margin: 16px 0;
}

.scale-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
}

.scale-table th, .scale-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
}

.scale-table th {
    background: var(--bg-main);
    color: var(--text-primary);
    font-weight: 600;
}

.formula-box {
    background: var(--accent-light);
    border-left: 4px solid var(--accent);
    padding: 16px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.95rem;
    color: var(--accent-hover);
    margin-top: 12px;
}

/* FOOTER */
.footer {
    background: var(--card-bg);
    border-top: 1px solid var(--border);
    padding: 24px;
    margin-top: auto;
}

.footer-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.footer-links {
    display: flex;
    gap: 16px;
    list-style: none;
}

.footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
}

.footer-links a:hover {
    color: var(--accent);
}

/* RESPONSIVE DESIGN */
@media (max-width: 680px) {
    .table-header { display: none; }
    .course-row {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        background: var(--bg-main);
        padding: 12px;
        border-radius: var(--radius-md);
        position: relative;
    }
    .course-name { grid-column: span 2; }
    .btn-remove {
        position: absolute;
        top: 8px;
        right: 8px;
    }
    .results-container {
        flex-direction: column;
        gap: 16px;
    }
    .result-divider {
        width: 100%;
        height: 1px;
    }
    .footer-container {
        flex-direction: column;
        gap: 12px;
        text-align: center;
    }
}